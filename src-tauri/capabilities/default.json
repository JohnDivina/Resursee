{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Resursee desktop windows",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://resursee.vercel.app/*",
      "https://*.vercel.app/*",
      "http://localhost:3000/*"
    ]
  },
  "permissions": [
    "core:default"
  ]
}
